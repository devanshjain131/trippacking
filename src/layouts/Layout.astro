---
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
	metaKeywords?: string;
	ogTitle?: string;
	ogDescription?: string;
	ogUrl?: string;
	ogImage?: string;
	appendMonthYear?: boolean;
	noindex?: boolean;
}

const {
	title = "Trip Packing List — AI Packing Checklist Generator",
	description = "Create personalized, smart travel packing lists in seconds. Track luggage weight dynamically, estimate airline limits, and avoid overweight baggage fees.",
	metaKeywords = "Trip Packing List, beach trip packing list, road trip packing list, ski trip packing list, trip packing list, weekend trip packing list, international trip packing list, business trip packing list, work trip packing list, camping trip packing list, family ski trip packing list, 4 day trip packing list, 2 week trip packing list female, overnight trip packing list, 3 day trip packing list, hiking trip packing list, week trip packing list, lake trip packing list, disney trip packing list, 5 day trip packing list, family road trip packing list, luggage weight tracker, travel checklist generator, bag weight calculator, airline luggage weight estimator, how to pack under 50 lbs, luggage weight calculator, airline baggage scale",
	ogTitle,
	ogDescription,
	ogUrl,
	ogImage = "https://tripspackinglist.com/og-image.png",
	appendMonthYear = false,
	noindex = false,
} = Astro.props;

const currentMonth = new Date().toLocaleString("en-US", { month: "long" });
const currentYear = new Date().getFullYear();
const monthYearStr = `${currentMonth} ${currentYear}`;

const finalTitle = appendMonthYear ? `${title} (${monthYearStr})` : title;
const finalDescription = appendMonthYear
	? `${description} (Updated ${monthYearStr})`
	: description;

const finalOgTitle = ogTitle
	? appendMonthYear
		? `${ogTitle} (${monthYearStr})`
		: ogTitle
	: finalTitle;
const finalOgDescription = ogDescription
	? appendMonthYear
		? `${ogDescription} (Updated ${monthYearStr})`
		: ogDescription
	: finalDescription;
const canonicalURL = new URL(
	Astro.url.pathname,
	Astro.site || "https://tripspackinglist.com",
);
const finalOgUrl = ogUrl || canonicalURL.href;
---

<!doctype html>
<html lang="en" class="scroll-smooth overflow-x-hidden">
	<head>
		<!-- Google tag (gtag.js) - Optimized Loading -->
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag("js", new Date());
			gtag("config", "G-HPDZZ06HRX");

			// Defer GTM script injection until browser is idle to boost performance scores
			window.addEventListener("load", () => {
				const loadGtag = () => {
					const script = document.createElement("script");
					script.async = true;
					script.src = "https://www.googletagmanager.com/gtag/js?id=G-HPDZZ06HRX";
					document.head.appendChild(script);
				};
				if ("requestIdleCallback" in window) {
					requestIdleCallback(loadGtag);
				} else {
					setTimeout(loadGtag, 1000);
				}
			});
		</script>

		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />

		<!-- SEO Meta Tags -->
		<title>{finalTitle}</title>
		<meta name="description" content={finalDescription} />
		<link rel="canonical" href={canonicalURL} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<meta name="keywords" content={metaKeywords} />
		<meta name="author" content="Trip Packing List" />

		<!-- OpenGraph Meta Tags -->
		<meta property="og:title" content={finalOgTitle} />
		<meta property="og:description" content={finalOgDescription} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={finalOgUrl} />
		<meta property="og:site_name" content="Trip Packing List" />
		<meta property="og:image" content={ogImage} />

		<!-- Twitter Card Meta Tags -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={finalOgTitle} />
		<meta name="twitter:description" content={finalOgDescription} />
		<meta name="twitter:site" content="@tripspackinglist" />
		<meta name="twitter:image" content={ogImage} />

		<!-- Favicons -->
		<link
			rel="icon"
			type="image/png"
			href="/favicon-96x96.png"
			sizes="96x96"
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link
			rel="apple-touch-icon"
			sizes="180x180"
			href="/apple-touch-icon.png"
		/>
		<meta name="apple-mobile-web-app-title" content="Trip Packing" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />

		<!-- Preload Critical Font Files to prevent layout shifts (CLS) and render delays -->
		<link
			rel="preload"
			href="https://fonts.gstatic.com/s/geist/v5/gyByhwUxId8gMEwcGFU.woff2"
			as="font"
			type="font/woff2"
			crossorigin="anonymous"
		/>
		<link
			rel="preload"
			href="https://fonts.gstatic.com/s/geistmono/v5/or3yQ6H-1_WfwkMZI_qYPLs1a-t7PU0AbeE9KK5U5Ck.woff2"
			as="font"
			type="font/woff2"
			crossorigin="anonymous"
		/>

		<!-- Optimized Inlined Web Fonts -->
		<style is:inline>
			/* Geist Variable Font (weights 400, 500, 600) */
			/* latin-ext */
			@font-face {
				font-family: 'Geist';
				font-style: normal;
				font-weight: 400 600;
				font-display: swap;
				src: url(https://fonts.gstatic.com/s/geist/v5/gyByhwUxId8gMEwSGFWfOw.woff2) format('woff2');
				unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
			}
			/* latin */
			@font-face {
				font-family: 'Geist';
				font-style: normal;
				font-weight: 400 600;
				font-display: swap;
				src: url(https://fonts.gstatic.com/s/geist/v5/gyByhwUxId8gMEwcGFU.woff2) format('woff2');
				unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
			}

			/* Geist Mono Regular (weight 400) */
			/* latin-ext */
			@font-face {
				font-family: 'Geist Mono';
				font-style: normal;
				font-weight: 400;
				font-display: swap;
				src: url(https://fonts.gstatic.com/s/geistmono/v5/or3yQ6H-1_WfwkMZI_qYPLs1a-t7PU0AbeE9KK5a5ClqOw.woff2) format('woff2');
				unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
			}
			/* latin */
			@font-face {
				font-family: 'Geist Mono';
				font-style: normal;
				font-weight: 400;
				font-display: swap;
				src: url(https://fonts.gstatic.com/s/geistmono/v5/or3yQ6H-1_WfwkMZI_qYPLs1a-t7PU0AbeE9KK5U5Ck.woff2) format('woff2');
				unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
			}
		</style>
		<!-- Theme Detection Script -->
		<script is:inline>
			(function () {
				const savedTheme = localStorage.getItem("theme");
				const prefersDark = window.matchMedia(
					"(prefers-color-scheme: dark)",
				).matches;
				if (savedTheme === "dark" || (!savedTheme && prefersDark)) {
					document.documentElement.classList.add("dark");
				} else if (savedTheme === "light") {
					document.documentElement.classList.add("light");
				}
			})();
		</script>
	</head>
	<body
		class="min-h-screen flex flex-col bg-canvas-soft text-ink select-text selection:bg-primary selection:text-on-primary overflow-x-hidden"
	>
		<slot />
	</body>
</html>
