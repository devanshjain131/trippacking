---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout 
  title="400: Bad Request — Trip Packing List" 
  description="The server could not understand your request."
  noindex={true}
>
  <Header />

  <div class="relative overflow-hidden w-full flex flex-col items-center flex-1 justify-center py-16 px-6 bg-canvas-soft">
    <!-- Blueprint Grid Background -->
    <div class="absolute inset-0 z-0 bg-[linear-gradient(to_right,rgba(128,128,128,0.06)_1px,transparent_1px),linear-gradient(to_bottom,rgba(128,128,128,0.06)_1px,transparent_1px)] bg-[size:24px_24px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_50%,#000_70%,transparent_100%)] opacity-60 pointer-events-none"></div>

    <!-- Ambient Glowing Backdrops -->
    <div class="absolute top-[20%] left-[50%] -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] rounded-full bg-gradient-to-tr from-[#f5a623]/10 to-[#ffdf28]/10 blur-[100px] pointer-events-none z-0"></div>

    <main class="w-full max-w-4xl mx-auto z-10 flex flex-col items-center text-center">
      
      <!-- Visual File Corrupted Graphic -->
      <div class="relative mb-8 select-none group flex flex-col items-center">
        <div class="relative w-40 h-40 flex items-center justify-center border border-hairline rounded-full bg-canvas shadow-level3 mb-4 overflow-hidden">
          
          <!-- File warning SVG icon -->
          <svg class="w-16 h-16 text-ink/85 z-20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z" />
            <polyline points="14 2 14 8 20 8" />
            <!-- Flashing warning details inside file -->
            <line x1="12" y1="12" x2="12" y2="15" stroke="#f5a623" stroke-width="2" />
            <circle cx="12" cy="18" r="0.75" fill="#f5a623" />
          </svg>

          <!-- Warning overlay pulse -->
          <div class="absolute inset-0 bg-[#f5a623]/[0.02] animate-pulse z-0"></div>
          
          <!-- Fault blip ring -->
          <div class="absolute w-24 h-24 rounded-full border border-[#f5a623]/25 animate-ping z-10" style="animation-duration: 3.5s;"></div>
        </div>
      </div>

      <!-- Glassy card holding details & JSON validation editor mockup -->
      <div class="bg-canvas border border-hairline shadow-level4 rounded-3xl p-8 md:p-12 max-w-2xl w-full mx-auto flex flex-col items-center backdrop-blur-md">
        
        <!-- Eyebrow Status Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#f5a623]/10 border border-[#f5a623]/20 text-[#ab570a] mb-6">
          <span class="w-2 h-2 bg-[#f5a623] rounded-full animate-pulse"></span>
          <span class="font-mono text-xs font-semibold tracking-wider uppercase">400: Bad Request</span>
        </div>

        <h2 class="text-3xl md:text-4xl font-sans font-bold tracking-tight text-ink mb-3 sentence-case">
          Corrupted flight plan.
        </h2>

        <p class="text-sm md:text-base text-body/90 font-sans leading-relaxed max-w-lg mb-8">
          The server could not understand your request. This happens when the request is sent with invalid parameters or malformed data payload syntax.
        </p>

        <!-- JSON Validation Code Editor Mockup -->
        <div class="w-full max-w-lg bg-[#111] text-[#f5f5f5] rounded-xl overflow-hidden shadow-level4 border border-white/5 mb-8 text-left">
          <!-- Terminal Header -->
          <div class="bg-[#1a1a1a] px-4 py-2 border-b border-white/5 flex items-center justify-between font-sans">
            <div class="flex items-center gap-1.5 shrink-0">
              <span class="w-2.5 h-2.5 rounded-full bg-[#ff5f56]"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-[#ffbd2e]"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-[#27c93f]"></span>
            </div>
            <span class="font-mono text-[10px] text-white/40 font-medium uppercase tracking-wider">Editor — Payload Validation</span>
            <span class="w-14"></span>
          </div>
          <!-- Editor Body -->
          <div class="p-4 font-mono text-[11px] leading-relaxed select-text overflow-x-auto">
            <div class="text-[#888]">{`{`}</div>
            <div class="pl-4 text-white/80">"request": "generate_packing_list",</div>
            <div class="pl-4 text-white/80">"status": <span class="text-[#ffbd2e]">400</span>,</div>
            <div class="pl-4 text-[#ff5f56]">"validation_errors": [</div>
            <div class="pl-8 text-white/60">"destination: <span class="text-[#ff5f56] font-semibold underline decoration-wavy">null</span> (Must be a non-empty string)",</div>
            <div class="pl-8 text-white/60">"duration: <span class="text-[#ff5f56] font-semibold underline decoration-wavy">-7</span> (Must be a positive integer)"</div>
            <div class="pl-4 text-[#ff5f56]">]</div>
            <div class="text-[#888]">{`}`}</div>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row items-center gap-3 w-full justify-center">
          <button 
            id="back-history-btn"
            class="group relative inline-flex items-center justify-center gap-2 h-11 px-6 w-full sm:w-auto rounded-full bg-ink text-white font-medium text-sm overflow-hidden transition-all hover:scale-105 active:scale-95 shadow-level2 cursor-pointer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:-translate-x-0.5 shrink-0">
              <line x1="19" y1="12" x2="5" y2="12"></line>
              <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            <span>Go Back</span>
          </button>
          
          <a href="/" class="group inline-flex items-center justify-center gap-2 h-11 px-6 w-full sm:w-auto rounded-full bg-canvas-soft border border-hairline hover:bg-canvas text-ink font-medium text-sm transition-all hover:scale-105 active:scale-95 hover:border-hairline-strong hover:shadow-level1">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:scale-110 shrink-0">
              <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
            Return Home
          </a>
        </div>
      </div>

    </main>
  </div>

  <Footer />
</Layout>

<script is:inline>
  // Handle go back browser history action
  const backBtn = document.getElementById("back-history-btn");
  if (backBtn) {
    backBtn.addEventListener("click", () => {
      if (window.history.length > 1) {
        window.history.back();
      } else {
        window.location.href = "/";
      }
    });
  }
</script>
