---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const faqs = [
  {
    q: "What is the 5 4 3 2 1 rule for packing?",
    a: "The 5-4-3-2-1 rule is a popular minimalist packing method designed to help travelers pack efficiently for a week-long trip without overpacking. The rule outlines a simple countdown for your wardrobe: pack exactly five sets of socks and underwear, four versatile tops or shirts that can be layered, three bottoms such as pants, shorts, or skirts, two pairs of comfortable shoes suitable for walking and dining, and one hat or heavy jacket depending on your destination's climate. By adhering strictly to this structured formula, you can easily mix and match items to create a wide variety of outfits. This system ensures that your luggage remains lightweight, fits comfortably into a standard carry-on bag, and eliminates the stress of carrying unnecessary clothing items."
  },
  {
    q: "What to pack on every trip?",
    a: "Regardless of your destination or the duration of your journey, there are several absolute essentials that you must pack on every single trip. First and foremost, secure your official documentation, including a valid passport or government-issued photo ID, visa documents, and physical credit or debit cards. For health and safety, always carry a small kit of standard emergency medicines, prescription drugs, and basic first-aid supplies. In today's digital world, do not forget your smartphone, a reliable charger, and a universal travel plug adapter to keep your devices powered. Finally, pack personal hygiene items like toothbrushes, toothpaste, and a couple of changes of clean underwear in your carry-on bag, ensuring you remain comfortable even if checked baggage is delayed."
  },
  {
    q: "What is the 3-3-3 rule for travel packing?",
    a: "The 3-3-3 rule is a highly effective capsule wardrobe formula designed to simplify travel packing and maximize outfit variety with minimal items. To apply this method, you select three versatile tops, three coordinating bottoms, and three distinct pairs of shoes suitable for different occasions. By choosing items that share a cohesive color palette and can be easily layered, these nine pieces can be mixed and matched to generate over a dozen unique outfit combinations. This strategy is ideal for carry-on-only travelers who want to look stylish and prepared for both casual daytime sightseeing and formal evening dinners, all while keeping their suitcase incredibly light, organized, and free from unnecessary clutter."
  },
  {
    q: "What is the 3 5 7 rule for packing?",
    a: "The 3-5-7 rule is a stay-duration guideline specifically designed for week-long vacations to help you pack efficiently without bringing too much gear. Under this guideline, you pack exactly three pairs of shoes or key accessories, five bottoms such as pants, skirts, or shorts, and seven tops or shirts. By selecting basic, coordinating garments that can be layered and interchanged, you can easily create over fourteen distinct outfits, ensuring you have a fresh look for every day and night of your trip. This balanced approach helps you keep your suitcase light, fits neatly into standard overhead compartments, and prevents you from packing redundant garments that end up unused."
  },
  {
    q: "What is the golden rule of packing?",
    a: "The golden rule of packing is a classic piece of travel wisdom: lay out all the clothes and money you think you will need for your trip, then take half the clothes and twice the money. Underpacking your wardrobe forces you to focus on highly versatile, lightweight garments that can be worn multiple times, which reduces physical strain and avoids costly airline baggage fees. Meanwhile, doubling your travel funds provides a crucial financial safety net for emergency purchases, unexpected transportation changes, or spontaneous local experiences. This simple philosophy encourages a minimalist, stress-free travel mindset, ensuring you are not weighed down by heavy bags while remaining financially prepared for any situation."
  },
  {
    q: "What are the 5 biggest packing mistakes to avoid?",
    a: "To ensure a smooth journey, there are five critical packing mistakes every traveler should avoid. First, stop overpacking 'just in case' clothes that you will likely never wear. Second, never put valuable items, critical medications, or essential electronics in checked bags; always keep them in your carry-on. Third, do not ignore airline weight and size limits, as this leads to unexpected and expensive fees at the gate. Fourth, avoid folding bulky garments, and instead use rolling techniques or compression cubes to optimize your space. Finally, never pack liquids unsafely without securing their caps and using waterproof bags, which prevents messy leaks from ruining your clean clothes during transit."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
};
---

<Layout 
  title="Trip Packing List — Free Smart Checklist Generator" 
  description="Generate your customized trip packing list in seconds. Track luggage weight dynamically, estimate airline limits, and plan smart. Avoid overweight baggage fees with our free weight calculator."
>
  <!-- Sticky Header -->
  <Header />

  <!-- Hero Decor: Ambient Mesh Gradients -->
  <div class="relative overflow-hidden w-full flex flex-col items-center">
    <!-- Mesh Gradient 1 -->
    <div class="absolute top-[-100px] left-[5%] w-[320px] md:w-[650px] h-[320px] md:h-[650px] rounded-full bg-gradient-to-r from-gradient-develop-start to-gradient-develop-end opacity-20 blur-[70px] md:blur-[120px] animate-mesh-slow-1 pointer-events-none z-0"></div>
    <!-- Mesh Gradient 2 -->
    <div class="absolute top-[-50px] right-[5%] w-[280px] md:w-[550px] h-[280px] md:h-[550px] rounded-full bg-gradient-to-r from-gradient-preview-start to-gradient-preview-end opacity-15 blur-[60px] md:blur-[100px] animate-mesh-slow-2 pointer-events-none z-0"></div>

    <!-- Main Container -->
    <main class="w-full max-w-[1200px] mx-auto px-6 md:px-8 py-16 md:py-24 z-10 flex flex-col gap-20">
      
      <!-- Hero Header Section -->
      <section class="text-center flex flex-col items-center gap-6 max-w-[800px] mx-auto select-none no-print">
        <!-- New Badge -->
        <span class="inline-flex items-center gap-1.5 px-3 py-1 text-[11px] font-mono font-medium tracking-wide text-body bg-canvas border border-hairline rounded-full shadow-level1 animate-fade-in">
          <span class="w-1.5 h-1.5 bg-[#0070f3] rounded-full"></span>
          Trip Packing List • Pack Smart. Travel Light.
        </span>

        <!-- Headline -->
        <h1 class="text-4xl md:text-[56px] font-sans font-semibold tracking-[-2px] text-ink leading-tight">
          Trip Packing List
        </h1>

        <!-- Subtitle -->
        <p class="text-base md:text-lg text-body font-sans font-normal leading-relaxed max-w-[620px]">
          Pack smart. Travel light. Customize checklists for any destination, calculate baggage weight in real-time, and stay completely organized.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col items-center gap-4 mt-2">
          <a href="#trip-packing-checklist" class="flex items-center justify-center h-10 px-6 rounded-full bg-primary hover:bg-primary/95 text-sm font-medium text-on-primary shadow-level3 transition-all duration-150">
            Start Packing
          </a>
          
          <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-xs text-mute font-mono">
            <a href="/about-us" class="hover:text-ink transition-colors">About Us</a>
            <span class="w-1 h-1 bg-hairline-strong/30 rounded-full"></span>
            <a href="/contact-us" class="hover:text-ink transition-colors">Contact Us</a>
            <span class="w-1 h-1 bg-hairline-strong/30 rounded-full"></span>
            <a href="/privacy-policy" class="hover:text-ink transition-colors">Privacy Policy</a>
            <span class="w-1 h-1 bg-hairline-strong/30 rounded-full"></span>
            <a href="/terms-and-conditions" class="hover:text-ink transition-colors">Terms & Conditions</a>
          </div>
        </div>
      </section>

      <!-- Generator Section -->
      <section id="trip-packing-checklist" class="w-full scroll-mt-24">
        <!-- Dashboard & Form Container -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          
          <!-- LEFT SIDE: Generator Form & Saved Trips Dashboard -->
          <div class="lg:col-span-4 flex flex-col gap-6 no-print">
            <!-- Settings Card -->
            <div class="bg-canvas border border-hairline rounded-lg p-6 shadow-level3 flex flex-col gap-5">
            <h2 class="font-sans font-semibold text-lg text-ink tracking-tight border-b border-hairline pb-2.5">
              Trip Settings
            </h2>

            <form id="generator-form" class="flex flex-col gap-4">
              <!-- Where To -->
              <div class="flex flex-col gap-1.5">
                <label for="destination" class="text-xs font-medium text-body">Where to?</label>
                <input 
                  type="text" 
                  id="destination" 
                  placeholder="e.g. Tokyo, Paris, Iceland" 
                  required 
                  class="h-9 w-full border border-hairline rounded-sm bg-canvas hover:border-hairline-strong focus:border-primary px-3 text-sm text-ink outline-none transition-colors"
                />
              </div>

              <!-- How Long -->
              <div class="flex flex-col gap-1.5">
                <label for="duration" class="text-xs font-medium text-body">Duration (Days)</label>
                <select 
                  id="duration" 
                  class="h-9 w-full border border-hairline rounded-sm bg-canvas hover:border-hairline-strong focus:border-primary px-2 text-sm text-ink outline-none transition-colors cursor-pointer"
                >
                  {Array.from({ length: 30 }, (_, i) => i + 1).map((d) => (
                    <option value={d} selected={d === 7}>
                      {d} {d === 1 ? "Day" : "Days"}{d === 3 ? " (Weekend)" : ""}{d === 7 ? " (1 Week)" : ""}{d === 14 ? " (2 Weeks)" : ""}{d === 30 ? " (1 Month)" : ""}
                    </option>
                  ))}
                </select>
              </div>

              <!-- Climate / Weather -->
              <div class="flex flex-col gap-1.5">
                <span class="text-xs font-medium text-body block">Expected Climate</span>
                <div class="grid grid-cols-2 gap-2 text-xs">
                  <label class="flex items-center gap-2 p-2 border border-hairline rounded-sm bg-canvas hover:bg-canvas-soft cursor-pointer transition-colors">
                    <input type="radio" name="climate" value="sunny" checked class="accent-primary" />
                    ☀️ Warm & Sunny
                  </label>
                  <label class="flex items-center gap-2 p-2 border border-hairline rounded-sm bg-canvas hover:bg-canvas-soft cursor-pointer transition-colors">
                    <input type="radio" name="climate" value="autumn" class="accent-primary" />
                    🍂 Cool / Autumn
                  </label>
                  <label class="flex items-center gap-2 p-2 border border-hairline rounded-sm bg-canvas hover:bg-canvas-soft cursor-pointer transition-colors">
                    <input type="radio" name="climate" value="rainy" class="accent-primary" />
                    🌧️ Rainy & Wet
                  </label>
                  <label class="flex items-center gap-2 p-2 border border-hairline rounded-sm bg-canvas hover:bg-canvas-soft cursor-pointer transition-colors">
                    <input type="radio" name="climate" value="snowy" class="accent-primary" />
                    ❄️ Freezing / Snow
                  </label>
                </div>
              </div>

              <!-- Group Type / Travelers -->
              <div class="flex flex-col gap-1.5">
                <label for="travelers-type" class="text-xs font-medium text-body">Who is packing?</label>
                <select 
                  id="travelers-type" 
                  class="h-9 w-full border border-hairline rounded-sm bg-canvas hover:border-hairline-strong focus:border-primary px-2 text-sm text-ink outline-none transition-colors cursor-pointer"
                >
                  <option value="solo" selected>Just Me (Solo)</option>
                  <option value="couple">Me + Partner (Couple)</option>
                  <option value="family">Family (Me, Partner, Kids)</option>
                </select>
              </div>

              <!-- Gender Selection Container -->
              <div id="gender-selection-container" class="flex flex-col gap-3">
                <!-- Dynamically populated via JS -->
              </div>

              <!-- Activities -->
              <div class="flex flex-col gap-1.5">
                <span class="text-xs font-medium text-body block">Activities planned</span>
                <div class="flex flex-col gap-2 border border-hairline rounded-sm p-3 bg-canvas-soft text-xs max-h-[150px] overflow-y-auto">
                  <label class="flex items-center gap-2 cursor-pointer hover:text-ink transition-colors">
                    <input type="checkbox" name="activities" value="beach" class="accent-primary" />
                    🏝️ Beach & Swimming
                  </label>
                  <label class="flex items-center gap-2 cursor-pointer hover:text-ink transition-colors">
                    <input type="checkbox" name="activities" value="hiking" class="accent-primary" />
                    🏔️ Hiking & Outdoors
                  </label>
                  <label class="flex items-center gap-2 cursor-pointer hover:text-ink transition-colors">
                    <input type="checkbox" name="activities" value="trekking" class="accent-primary" />
                    🥾 Trekking & Expedition
                  </label>
                  <label class="flex items-center gap-2 cursor-pointer hover:text-ink transition-colors">
                    <input type="checkbox" name="activities" value="business" class="accent-primary" />
                    👔 Business / Conferences
                  </label>
                  <label class="flex items-center gap-2 cursor-pointer hover:text-ink transition-colors">
                    <input type="checkbox" name="activities" value="city" checked class="accent-primary" />
                    🌆 City Exploration
                  </label>
                  <label class="flex items-center gap-2 cursor-pointer hover:text-ink transition-colors">
                    <input type="checkbox" name="activities" value="winter" class="accent-primary" />
                    🎿 Winter Sports
                  </label>
                  <label class="flex items-center gap-2 cursor-pointer hover:text-ink transition-colors">
                    <input type="checkbox" name="activities" value="backpacking" class="accent-primary" />
                    🎒 Backpacking / Budget
                  </label>
                  <label class="flex items-center gap-2 cursor-pointer hover:text-ink transition-colors">
                    <input type="checkbox" name="activities" value="cruise" class="accent-primary" />
                    🚢 Cruise & Sailing
                  </label>
                  <label class="flex items-center gap-2 cursor-pointer hover:text-ink transition-colors">
                    <input type="checkbox" name="activities" value="camping" class="accent-primary" />
                    ⛺ Camping & Outdoors
                  </label>
                  <label class="flex items-center gap-2 cursor-pointer hover:text-ink transition-colors">
                    <input type="checkbox" name="activities" value="dining" class="accent-primary" />
                    🍷 Dining & Nightlife
                  </label>
                  <label class="flex items-center gap-2 cursor-pointer hover:text-ink transition-colors">
                    <input type="checkbox" name="activities" value="photography" class="accent-primary" />
                    📸 Photography & Vlogging
                  </label>
                  <label class="flex items-center gap-2 cursor-pointer hover:text-ink transition-colors">
                    <input type="checkbox" name="activities" value="fitness" class="accent-primary" />
                    🏃 Gym & Fitness
                  </label>
                  <label class="flex items-center gap-2 cursor-pointer hover:text-ink transition-colors">
                    <input type="checkbox" name="activities" value="trekking" class="accent-primary" />
                    🥾 Trekking & Expedition
                  </label>
                </div>
              </div>

              <button 
                type="submit" 
                class="h-9 w-full mt-2 rounded-sm bg-primary hover:bg-primary/95 text-xs font-medium text-on-primary shadow-level2 transition-all duration-150"
              >
                Start Packing
              </button>
            </form>
          </div>

          <!-- Saved Trips Card -->
            <div class="bg-canvas border border-hairline rounded-lg p-5 shadow-level3 flex flex-col gap-4">
              <h3 class="font-sans font-semibold text-[15px] tracking-tight text-ink border-b border-hairline pb-2 flex items-center justify-between">
                My Saved Trips
                <span id="saved-trips-count" class="text-xs font-mono text-[#888888] font-normal">0 saved</span>
              </h3>
              <div id="saved-trips-list" class="flex flex-col gap-2 max-h-[220px] overflow-y-auto text-xs text-body">
                <p id="saved-trips-empty" class="text-center py-6 text-[#888888] italic">No saved trips found. Generated lists will auto-save here.</p>
              </div>
            </div>
          </div>

          <!-- RIGHT SIDE: Packing List Dashboard -->
          <div class="lg:col-span-8 flex flex-col gap-6">
            
            <!-- Dashboard Empty State -->
            <div id="dashboard-empty-state" class="hidden lg:flex bg-canvas border border-hairline rounded-lg p-14 shadow-level3 text-center flex-col items-center gap-4 select-none no-print">
              <div class="w-12 h-12 bg-canvas-soft-2 border border-hairline rounded-full flex items-center justify-center text-body mb-2 shadow-level1">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M16 16v1a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2v1"/>
                  <path d="M18 8h4a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2h-4"/>
                  <path d="M16 8V6a2 2 0 0 0-2-2H3"/>
                </svg>
              </div>
              <h3 class="font-sans font-semibold text-lg text-ink">No checklist active</h3>
              <p class="text-body text-sm max-w-[340px] leading-relaxed">
                Configure your trip settings on the left to generate your smart travel packing checklist.
              </p>
            </div>

            <!-- Dashboard Loading State -->
            <div id="dashboard-loading-state" class="hidden bg-canvas border border-hairline rounded-lg p-14 shadow-level3 text-center flex flex-col items-center justify-center gap-4 select-none no-print min-h-[300px]">
              <div class="relative w-16 h-16 flex items-center justify-center">
                <div class="absolute inset-0 rounded-full border-2 border-primary/10 border-t-primary animate-spin"></div>
                <svg class="w-6 h-6 text-primary animate-pulse" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="8" width="18" height="12" rx="2" />
                  <path d="M8 8V6a2 2 0 012-2h4a2 2 0 012 2v2" />
                </svg>
              </div>
              <h3 class="font-sans font-semibold text-lg text-ink">Analyzing your trip...</h3>
              <p class="text-body text-xs max-w-[280px] leading-relaxed">
                Applying local-first packing algorithms and preparing your customized checklist.
              </p>
            </div>

            <!-- Main Interactive Checklist (Hidden Initially) -->
            <div id="packing-dashboard" style="display:none" class="flex flex-col gap-6">
              
              <!-- Sticky Progress & Controls Header -->
              <div class="bg-canvas border border-hairline rounded-lg p-5 shadow-level3 flex flex-col gap-4 no-print select-none">
                <!-- Row 1: Trip Metadata and Weight -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-hairline pb-4">
                  <div class="flex flex-col">
                    <h3 id="dash-trip-title" class="font-sans font-semibold text-xl tracking-tight text-ink">Trip to Tokyo</h3>
                    <span id="dash-trip-meta" class="text-xs font-mono text-mute mt-0.5">7 Days &bull; Sunny climate &bull; Solo</span>
                  </div>
                  
                  <!-- Weight Calculator Box -->
                  <div id="luggage-weight-box" class="flex items-center gap-3.5 px-4 py-2 bg-canvas-soft border border-hairline rounded-sm shadow-level1 transition-all duration-300">
                    <div class="flex flex-col">
                      <div class="flex items-center gap-2">
                        <span class="text-[10px] font-mono text-mute uppercase tracking-wider">Bag Weight</span>
                        <!-- Segmented Pill Toggle -->
                        <div class="flex bg-canvas-soft-2 border border-hairline rounded-full p-[1.5px] select-none no-print">
                          <button id="unit-lbs" type="button" class="px-1.5 py-0.5 rounded-full text-[8px] font-bold font-mono transition-all cursor-pointer leading-none uppercase bg-white dark:bg-canvas text-ink shadow-sm border border-hairline">lbs</button>
                          <button id="unit-kg" type="button" class="px-1.5 py-0.5 rounded-full text-[8px] font-bold font-mono transition-all cursor-pointer leading-none uppercase text-mute hover:text-ink border border-transparent">kg</button>
                        </div>
                      </div>
                      <span id="estimated-weight" class="text-sm font-semibold font-mono text-ink">0.0 lbs</span>
                    </div>
                    <div class="h-6 w-[1px] bg-hairline"></div>
                    <div class="flex flex-col">
                      <span class="text-[10px] font-mono text-mute uppercase tracking-wider">Status</span>
                      <span id="weight-status" class="text-xs font-medium text-success">Within Limit</span>
                    </div>
                  </div>
                </div>

                <!-- Row 2: Progress Bar and Reset -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                  <!-- Progress bar element -->
                  <div class="flex-1 flex items-center gap-4">
                    <span id="packed-ratio" class="text-xs font-mono text-body min-w-[90px]">0 of 0 packed</span>
                    <div class="flex-1 h-2 bg-canvas-soft-2 border border-hairline rounded-full overflow-hidden">
                      <div id="packed-progress-fill" class="h-full bg-success transition-all duration-300 w-0"></div>
                    </div>
                  </div>

                  <!-- Actions Cluster -->
                  <div class="flex items-center gap-2">
                    <button id="reset-checklist-btn" class="h-7 px-3 border border-hairline rounded-sm bg-canvas hover:bg-canvas-soft text-[11px] font-medium text-body hover:text-ink transition-colors duration-150">
                      Reset
                    </button>
                    <button id="print-checklist-btn" class="h-7 px-3 border border-hairline rounded-sm bg-canvas hover:bg-canvas-soft text-[11px] font-medium text-body hover:text-ink transition-colors duration-150 flex items-center gap-1.5">
                      <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 6 2 18 2 18 9"/>
                        <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/>
                        <rect x="6" y="14" width="12" height="8"/>
                      </svg>
                      Print List
                    </button>
                    <button id="save-current-trip-btn" class="h-7 px-3.5 rounded-sm bg-primary hover:bg-primary/90 text-[11px] font-medium text-on-primary shadow-level2 transition-all duration-150">
                      Save List
                    </button>
                  </div>
                </div>

                <!-- Row 3: Traveler Sub-tabs (Me, Partner, Kids) -->
                <div id="traveler-tabs-container" class="hidden border-t border-hairline pt-3 flex items-center gap-2 text-xs">
                  <span class="text-[11px] text-mute font-medium mr-2">Traveler:</span>
                  <div id="traveler-tabs" class="flex items-center gap-1">
                    <!-- Tabs dynamically rendered -->
                  </div>
                </div>
              </div>

              <!-- Print View Header (only displays when printing) -->
              <div class="hidden print-only print-card">
                <h2 id="print-title" class="text-3xl font-bold font-sans">Trip Packing Checklist</h2>
                <p id="print-meta" class="text-xs font-mono text-gray-500 mt-1">Generated by TripPackingList.com</p>
              </div>

              <!-- Checklists Categories Grid -->
              <div id="categories-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Renders Category Cards dynamically -->
              </div>

              <!-- Dynamic Category Addition Panel -->
              <div class="bg-canvas border border-hairline rounded-lg p-5 shadow-level3 flex flex-col sm:flex-row items-center gap-3 no-print select-none">
                <div class="flex-1 flex flex-col gap-1.5 w-full">
                  <label for="new-category-input" class="text-xs font-medium text-body">Need an extra category?</label>
                  <input 
                    type="text" 
                    id="new-category-input" 
                    placeholder="e.g. Baby Gear, Photography Accessories" 
                    class="h-8 w-full border border-hairline rounded-sm bg-canvas hover:border-hairline-strong px-3 text-xs text-ink outline-none"
                  />
                </div>
                <button 
                  type="button"
                  id="add-category-btn" 
                  class="h-8 w-full sm:w-auto px-5 mt-auto rounded-sm bg-primary hover:bg-primary/95 text-xs font-medium text-on-primary transition-colors shrink-0"
                >
                  Create Category
                </button>
              </div>

            </div>
          </div>



        </div>
      </section>

      <!-- Popular Destinations Directory -->
      <section class="border-t border-hairline pt-16 no-print select-none">
        <div class="flex flex-col gap-3 mb-8 max-w-[600px]">
          <span class="font-mono text-[11px] text-[#0070f3] font-semibold tracking-wider uppercase">Directories</span>
          <h2 class="font-sans font-semibold text-2xl md:text-3xl tracking-tight text-ink leading-tight">
            Popular Travel Checklists
          </h2>
          <p class="text-sm text-body">
            Select a destination-specific packing guide to get detailed recommendations, packing strategies, and checklists.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
          <a href="/beach-trip-packing-list" class="flex items-center justify-between p-4 border border-hairline rounded-lg bg-canvas hover:border-hairline-strong hover:bg-canvas-soft-2 transition-all group">
            <span class="text-sm font-medium text-ink flex items-center gap-2">🏝️ Beach Trip Packing List</span>
            <svg class="w-3.5 h-3.5 text-mute group-hover:text-ink group-hover:translate-x-0.5 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
