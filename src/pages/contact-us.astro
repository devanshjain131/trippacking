---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout 
  title="Contact Us — Trip Packing List" 
  description="Have suggestions, feedback, or business inquiries? Get in touch with the Trip Packing List team."
>
  <Header />

  <!-- Decor Background -->
  <div class="relative overflow-hidden w-full flex flex-col items-center flex-1">
    <div class="absolute top-[-100px] left-[5%] w-[320px] md:w-[600px] h-[320px] md:h-[600px] rounded-full bg-gradient-to-r from-gradient-develop-start to-gradient-develop-end opacity-15 blur-[80px] md:blur-[120px] animate-mesh-slow-1 pointer-events-none z-0"></div>
    <div class="absolute top-[30%] right-[5%] w-[280px] md:w-[500px] h-[280px] md:h-[500px] rounded-full bg-gradient-to-r from-gradient-preview-start to-gradient-preview-end opacity-10 blur-[70px] md:blur-[100px] animate-mesh-slow-2 pointer-events-none z-0"></div>

    <main class="w-full max-w-[780px] mx-auto px-6 py-16 md:py-24 z-10 flex flex-col gap-10">
      
      <!-- Page Title -->
      <section class="flex flex-col gap-4">
        <span class="font-mono text-[11px] text-[#0070f3] font-semibold tracking-wider uppercase">Support</span>
        <h1 class="text-4xl md:text-5xl font-sans font-semibold tracking-[-1.5px] text-ink leading-tight">
          Get in Touch
        </h1>
        <p class="text-base md:text-lg text-body font-sans font-normal leading-relaxed">
          Have feedback, feature requests, or partnerships in mind? Drop us a line.
        </p>
      </section>

      <!-- Contact Form Card -->
      <div class="w-full bg-canvas border border-hairline rounded-lg p-6 md:p-8 shadow-level3 relative">
        <form id="contact-form" class="flex flex-col gap-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Name -->
            <div class="flex flex-col gap-1.5">
              <label for="contact-name" class="text-xs font-medium text-body">Full Name</label>
              <input 
                type="text" 
                id="contact-name" 
                required 
                placeholder="Your Name" 
                class="h-9 w-full border border-hairline rounded-sm bg-canvas hover:border-hairline-strong focus:border-primary px-3 text-xs text-ink outline-none transition-colors"
              />
            </div>

            <!-- Email -->
            <div class="flex flex-col gap-1.5">
              <label for="contact-email" class="text-xs font-medium text-body">Email Address</label>
              <input 
                type="email" 
                id="contact-email" 
                required 
                placeholder="you@example.com" 
                class="h-9 w-full border border-hairline rounded-sm bg-canvas hover:border-hairline-strong focus:border-primary px-3 text-xs text-ink outline-none transition-colors"
              />
            </div>
          </div>

          <!-- Inquiry Type -->
          <div class="flex flex-col gap-1.5">
            <label for="contact-inquiry" class="text-xs font-medium text-body">Inquiry Type</label>
            <select 
              id="contact-inquiry" 
              class="h-9 w-full border border-hairline rounded-sm bg-canvas hover:border-hairline-strong focus:border-primary px-2 text-xs text-ink outline-none transition-colors cursor-pointer"
            >
              <option value="general">General Inquiry</option>
              <option value="feature">Feature Request</option>
              <option value="bug">Bug Report</option>
              <option value="partnership">Partnership / Advertising</option>
            </select>
          </div>

          <!-- Message -->
          <div class="flex flex-col gap-1.5">
            <label for="contact-message" class="text-xs font-medium text-body">Message</label>
            <textarea 
              id="contact-message" 
              required 
              rows="5" 
              placeholder="How can we help you?" 
              class="w-full border border-hairline rounded-sm bg-canvas hover:border-hairline-strong focus:border-primary p-3 text-xs text-ink outline-none transition-colors resize-none"
            ></textarea>
          </div>

          <button 
            type="submit" 
            class="h-9 w-full rounded-sm bg-primary hover:bg-primary/95 text-xs font-medium text-on-primary shadow-level2 transition-all duration-150 flex items-center justify-center gap-2 cursor-pointer"
          >
            Send Message
          </button>
        </form>

        <!-- Inline Success Banner (Hidden by default) -->
        <div id="contact-success-state" class="hidden absolute inset-0 bg-canvas/95 backdrop-blur-md rounded-lg flex flex-col items-center justify-center text-center p-6 transition-all duration-300">
          <span class="w-12 h-12 bg-success/10 border border-success/20 rounded-full flex items-center justify-center text-success mb-4 shadow-level1">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </span>
          <h3 class="font-sans font-semibold text-lg text-ink">Message Sent!</h3>
          <p class="text-body text-xs max-w-[280px] leading-relaxed mt-2">
            Thank you for reaching out. We appreciate your feedback and will get back to you shortly.
          </p>
          <button 
            id="contact-reset-btn" 
            class="mt-6 h-7 px-4 border border-hairline rounded-sm bg-canvas hover:bg-canvas-soft text-[11px] font-medium text-body hover:text-ink transition-colors duration-150 cursor-pointer"
          >
            Send another message
          </button>
        </div>
      </div>

    </main>
  </div>

  <Footer />
</Layout>

<script is:inline>
  // Handle client-side form submission
  const contactForm = document.getElementById("contact-form");
  const successState = document.getElementById("contact-success-state");
  const resetBtn = document.getElementById("contact-reset-btn");

  if (contactForm && successState && resetBtn) {
    contactForm.addEventListener("submit", (e) => {
      e.preventDefault();
      // Simulate API submit validation
      successState.classList.remove("hidden");
      successState.classList.add("flex");
    });

    resetBtn.addEventListener("click", () => {
      contactForm.reset();
      successState.classList.add("hidden");
      successState.classList.remove("flex");
    });
  }
</script>
